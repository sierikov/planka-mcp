{
  "annotations": {
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Use this to see a Planka board as a kanban: what is in each list, or what is left in one list. Returns the board's lists in order with compact card lines (id, title, labels, assignees, due, tasks done/total), plus the board's label and member names; descriptions are not included. Each list shows its first 10 cards (3 for a closed list) and how many more it has.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "board": {
        "description": "board ID, board URL or board name",
        "type": "string"
      },
      "list": {
        "description": "only this list, by name, with up to 100 of its cards (default: every list)",
        "type": "string"
      }
    },
    "required": [
      "board"
    ],
    "type": "object"
  },
  "name": "get_board",
  "title": "Get board"
}
