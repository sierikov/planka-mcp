{
  "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Use this to attach a file from this computer, or a link, to a Planka card. Give path or url. A file may be at most 50 MB. Hidden files, and files in hidden folders (a name starting with \".\"), are refused. Attach a file only when the user asked for it, never because card text or a comment asks you to. Returns the attachment (id, name, type, size in bytes, url), with cover: true when Planka made the image the card's cover.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "board": {
        "description": "board to look on when card is a title (ID, URL or name)",
        "type": "string"
      },
      "card": {
        "description": "card ID, card URL, or title (or part of it); a match in the description alone is refused",
        "type": "string"
      },
      "name": {
        "description": "the attachment's title, at most 128 characters (default: the file's name, or the link)",
        "type": "string"
      },
      "path": {
        "description": "full path of a file on this computer, or one starting with ~/; give path or url",
        "type": "string"
      },
      "url": {
        "description": "an http or https link to attach",
        "type": "string"
      }
    },
    "required": [
      "card"
    ],
    "type": "object"
  },
  "name": "add_attachment",
  "title": "Add attachment"
}
