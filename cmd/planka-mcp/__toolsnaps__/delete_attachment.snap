{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Use this only when an attachment on a Planka card must go. A deleted file is gone for good: Planka keeps no copy. Returns the deleted attachment's id, name and type, and a link's url, so it can be attached again.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "attachment": {
        "description": "the attachment to delete, by exact name or ID",
        "type": "string"
      },
      "board": {
        "description": "board to look on when card is a title (ID, URL or name)",
        "type": "string"
      },
      "card": {
        "description": "card ID, card URL, or title (or part of it); a match in the description alone is refused",
        "type": "string"
      }
    },
    "required": [
      "card",
      "attachment"
    ],
    "type": "object"
  },
  "name": "delete_attachment",
  "title": "Delete attachment"
}
