{
  "annotations": {
    "idempotentHint": true,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Use this to rename an attachment on a Planka card, or to make an image the card's cover (cover=true) or stop it being the cover (cover=false). Fields you leave out stay as they are. Returns the attachment.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "attachment": {
        "description": "the attachment to change, by exact name or ID",
        "type": "string"
      },
      "board": {
        "description": "board to look on when card is a title (ID, URL or name)",
        "type": "string"
      },
      "card": {
        "description": "card ID, card URL, or title (or part of it); a match in the description alone is refused",
        "type": "string"
      },
      "cover": {
        "description": "true makes this image the card's cover; false removes it as the cover",
        "type": [
          "null",
          "boolean"
        ]
      },
      "name": {
        "description": "new name, at most 128 characters",
        "type": [
          "null",
          "string"
        ]
      }
    },
    "required": [
      "card",
      "attachment"
    ],
    "type": "object"
  },
  "name": "update_attachment",
  "title": "Update attachment"
}
