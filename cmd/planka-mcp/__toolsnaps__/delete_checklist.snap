{
  "annotations": {
    "destructiveHint": true,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false
  },
  "description": "Use this only when a checklist on a Planka card must go. Planka deletes the tasks in it for good, so a checklist with tasks is refused unless with_tasks=true; to keep them, move them first with update_tasks. Returns the deleted checklist's id and name, and the tasks deleted with it.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "board": {
        "description": "board to look on when card is a title (ID, URL or name)",
        "type": "string"
      },
      "card": {
        "description": "card ID, card URL, or title (or part of it); a match in the description alone is refused",
        "type": "string"
      },
      "checklist": {
        "description": "the checklist to delete, by exact name or ID",
        "type": "string"
      },
      "with_tasks": {
        "description": "also delete the tasks still in it (default false: a checklist with tasks is refused)",
        "type": "boolean"
      }
    },
    "required": [
      "card",
      "checklist"
    ],
    "type": "object"
  },
  "name": "delete_checklist",
  "title": "Delete checklist"
}
