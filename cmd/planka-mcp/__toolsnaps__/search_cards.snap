{
  "annotations": {
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": true
  },
  "description": "Use this to find Planka cards by words and filters. A card matches when each word starts a word in its title, or each in its description; title matches come first, in_description marks the rest. Returns compact card lines and how many more matched.",
  "inputSchema": {
    "additionalProperties": false,
    "properties": {
      "assignee": {
        "description": "only cards assigned to this person, by name; \"me\" is you",
        "type": "string"
      },
      "board": {
        "description": "only this board (ID, URL or name)",
        "type": "string"
      },
      "due": {
        "description": "only cards due: overdue (past due and not marked done), today, this_week (Monday to Sunday), or none (no due date), in the server's time zone",
        "enum": [
          "overdue",
          "today",
          "this_week",
          "none"
        ],
        "type": "string"
      },
      "include_archived": {
        "description": "also search archived cards (default false)",
        "type": "boolean"
      },
      "label": {
        "description": "only cards with this label, by name",
        "type": "string"
      },
      "limit": {
        "description": "most cards to return (default 20, at most 100)",
        "type": "integer"
      },
      "list": {
        "description": "only this list, by name",
        "type": "string"
      },
      "project": {
        "description": "only boards of this project, by name",
        "type": "string"
      },
      "query": {
        "description": "words to find, each at the start of a word (oma finds Omas, not Automated); optional, omit to list cards matching the filters",
        "type": "string"
      }
    },
    "type": "object"
  },
  "name": "search_cards",
  "title": "Search cards"
}
